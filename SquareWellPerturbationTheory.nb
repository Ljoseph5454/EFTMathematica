Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "System", " ", "Parameters"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hbar", "=", "1"}], ";", 
    RowBox[{"m", "=", "1"}], ";", 
    RowBox[{"a", "=", "1"}], ";", 
    RowBox[{"V0", "=", "9"}], ";", 
    RowBox[{"lTarget", "=", "1"}], ";", " ", 
    RowBox[{"\[Lambda]", "=", "0.2"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Define", " ", "the", " ", "Potentials"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VUnperturbed", "[", "r_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"r", "<", "a"}], ",", 
      RowBox[{
       RowBox[{"-", "V0"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "m"}], ")"}]}], ",", "0"}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"VPerturbed", "[", "r_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"r", "<", "a"}], ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"V0", "+", 
          RowBox[{"\[Lambda]", "*", "r"}]}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "m"}], ")"}]}], ",", "0"}], "]"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "0.5", "*", "r", " ", "is", " ", "the", " ", "test", " ", "shift"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Phase", " ", "Shift", " ", "Function", " ", 
     RowBox[{"(", 
      RowBox[{"now", " ", "accepts", " ", "MOMENTUM", " ", "k"}], ")"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhaseShift", "[", 
     RowBox[{
      RowBox[{"k_", "?", "NumericQ"}], ",", "l_Integer", ",", "pot_"}], "]"}],
     ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "E", ",", "Rmax", ",", "eps", ",", "eq", ",", "bc", ",", "solU", ",", 
        "Rfun", ",", "gamma", ",", "jVal", ",", "yVal", ",", "jDeriv", ",", 
        "yDeriv", ",", "num", ",", "den", ",", "delta"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"Calculate", " ", "Energy", " ", "from", " ", "Momentum"}], 
       "*)"}], 
      RowBox[{
       RowBox[{"E", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"hbar", "^", "2"}], "*", 
           RowBox[{"k", "^", "2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "m"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Rmax", "=", 
        RowBox[{"2", "*", "a"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"eps", "=", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"eq", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"hbar", "^", "2"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", "*", "m"}], ")"}]}], ")"}]}], "*", 
           RowBox[{
            RowBox[{"u", "''"}], "[", "r", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"pot", "[", "r", "]"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"hbar", "^", "2"}], "*", "l", "*", 
                RowBox[{"(", 
                 RowBox[{"l", "+", "1"}], ")"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", "*", "m", "*", 
                RowBox[{"r", "^", "2"}]}], ")"}]}]}], ")"}], "*", 
           RowBox[{"u", "[", "r", "]"}]}]}], "==", 
         RowBox[{"E", "*", 
          RowBox[{"u", "[", "r", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bc", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "eps", "]"}], "==", 
           RowBox[{"eps", "^", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}]}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "'"}], "[", "eps", "]"}], "==", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}], "*", 
            RowBox[{"eps", "^", "l"}]}]}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"solU", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eq", ",", "bc"}], "}"}], ",", "u", ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "eps", ",", "Rmax"}], "}"}], ",", 
          RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}], ",", 
          RowBox[{"MaxSteps", "->", "10000"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Rfun", "[", "r_", "]"}], ":=", 
        RowBox[{
         RowBox[{"solU", "[", "r", "]"}], "/", "r"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gamma", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Rfun", "'"}], "[", "Rmax", "]"}], "/", 
         RowBox[{"Rfun", "[", "Rmax", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"jVal", "=", 
        RowBox[{"SphericalBesselJ", "[", 
         RowBox[{"l", ",", 
          RowBox[{"k", "*", "Rmax"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"yVal", "=", 
        RowBox[{"SphericalBesselY", "[", 
         RowBox[{"l", ",", 
          RowBox[{"k", "*", "Rmax"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"jDeriv", "=", 
        RowBox[{"k", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"SphericalBesselJ", "[", 
              RowBox[{"l", ",", "rho"}], "]"}], ",", "rho"}], "]"}], "/.", 
           " ", 
           RowBox[{"rho", "->", 
            RowBox[{"k", "*", "Rmax"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yDeriv", "=", 
        RowBox[{"k", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"SphericalBesselY", "[", 
              RowBox[{"l", ",", "rho"}], "]"}], ",", "rho"}], "]"}], "/.", 
           " ", 
           RowBox[{"rho", "->", 
            RowBox[{"k", "*", "Rmax"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"num", "=", 
        RowBox[{"jDeriv", "-", 
         RowBox[{"gamma", "*", "jVal"}]}]}], ";", "\n", "     ", 
       RowBox[{"den", "=", 
        RowBox[{"yDeriv", "-", 
         RowBox[{"gamma", "*", "yVal"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"delta", "=", 
        RowBox[{"ArcTan", "[", 
         RowBox[{"den", ",", "num"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "delta", "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "Unwrap", " ", "and", " ", "Normalize", " ", 
     "the", " ", "Phase", " ", "Array"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"UnwrapPhase", "[", "data_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"unwrapped", "=", "data"}], ",", "diff", ",", "jump", ",", 
        "tailShift"}], "}"}], ",", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "2"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "unwrapped", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", 
         RowBox[{
          RowBox[{"diff", "=", 
           RowBox[{
            RowBox[{"unwrapped", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
            RowBox[{"unwrapped", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", "-", "1"}], ",", "2"}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "diff", "]"}], ">", 
             RowBox[{"Pi", "/", "2"}]}], ",", 
            RowBox[{
             RowBox[{"jump", "=", 
              RowBox[{"Pi", "*", 
               RowBox[{"Round", "[", 
                RowBox[{"diff", "/", "Pi"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"unwrapped", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"i", ";;"}], ",", "2"}], "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"unwrapped", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"i", ";;"}], ",", "2"}], "]"}], "]"}], "-", 
               "jump"}]}], ";"}]}], "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tailShift", "=", 
        RowBox[{
         RowBox[{"-", "Pi"}], "*", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "unwrapped", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "/", "Pi"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"unwrapped", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"unwrapped", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "+", "tailShift"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "unwrapped", "]"}]}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Generate", " ", "the", " ", "Raw", " ", "Data", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "terms", " ", "of", " ", "k"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"E", "=", 
      RowBox[{
       RowBox[{
       "25", " ", "roughly", " ", "corresponds", " ", "to", " ", "k"}], "=", 
       "7.07"}]}], ",", 
     RowBox[{
      RowBox[{
      "so", " ", "we", " ", "evaluate", " ", "up", " ", "to", " ", "k"}], "=",
       "8.0"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kRange", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.1", ",", "10", ",", "0.05"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rawUnperturbedData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kV", ",", 
         RowBox[{"PhaseShift", "[", 
          RowBox[{"kV", ",", "lTarget", ",", "VUnperturbed"}], "]"}]}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"kV", ",", "kRange"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rawPerturbedData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kV", ",", 
         RowBox[{"PhaseShift", "[", 
          RowBox[{"kV", ",", "lTarget", ",", "VPerturbed"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"kV", ",", "kRange"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Clean", " ", "the", " ", "Data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"smoothUnperturbedData", "=", 
     RowBox[{"UnwrapPhase", "[", "rawUnperturbedData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"smoothPerturbedData", "=", 
     RowBox[{"UnwrapPhase", "[", "rawPerturbedData", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4.", " ", "Plot", " ", "the", " ", "Clean"}], ",", 
     RowBox[{"Continuous", " ", "Phase", " ", "Shifts"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"smoothUnperturbedData", ",", "smoothPerturbedData"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Momentum (k)\>\"", 
        ",", "\"\<Phase Shift \\\\[Delta](k)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"\"\<Continuous Phase Shift (l=\>\"", "<>", 
       RowBox[{"ToString", "[", "lTarget", "]"}], "<>", "\"\<)\>\""}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Blue"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Dashed", ",", "Red"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Unperturbed\>\"", ",", "\"\<Perturbed\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "5.", " ", "Find", " ", "the", " ", "Resonances", " ", "Numerically", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "terms", " ", "of", " ", "k"}], ")"}]}], "*)"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Convert", " ", "old", " ", "guessE"}], "=", 
     RowBox[{"3.0", " ", "to", " ", 
      RowBox[{"k", ":", 
       RowBox[{"sqrt", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "*", "1", "*", "3.0"}], ")"}], "/", 
         RowBox[{"1", "~", "2.45"}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"guessK", "=", "0.5"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resKUnperturbed", "=", 
     RowBox[{"kV", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"PhaseShift", "[", 
           RowBox[{"kV", ",", "lTarget", ",", "VUnperturbed"}], "]"}], "]"}], 
         "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"kV", ",", "guessK"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resKPerturbed", "=", 
     RowBox[{"kV", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"PhaseShift", "[", 
           RowBox[{"kV", ",", "lTarget", ",", "VPerturbed"}], "]"}], "]"}], "==",
          "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"kV", ",", "guessK"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Exact Unperturbed Resonance k: \>\"", ",", 
      "resKUnperturbed"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Exact Perturbed Resonance k:   \>\"", ",", 
      "resKPerturbed"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Shift (\\\\[Delta]k):               \>\"", ",", 
      RowBox[{"resKPerturbed", "-", "resKUnperturbed"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
