Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ncurves", "=", "4"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Number", " ", "of", " ", "non", " ", "0", " ", "eigenvalue", " ", 
    "curves", " ", "for", " ", "a", " ", "particular", " ", "complex", " ", 
    "value"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OrlovEigenvalues", "[", "uin_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "uout", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"uout", "=", 
      RowBox[{"z", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"uin", "*", 
            RowBox[{"SphericalBesselJ", "[", 
             RowBox[{"lTarget", ",", 
              RowBox[{
               RowBox[{"Kmom", "[", "z", "]"}], "*", "a"}]}], "]"}], 
            RowBox[{"SphericalHankelH2", "[", 
             RowBox[{
              RowBox[{"lTarget", "-", "1"}], ",", 
              RowBox[{"uin", "*", "a"}]}], "]"}]}], "==", 
           RowBox[{
            RowBox[{"Kmom", "[", "z", "]"}], " ", 
            RowBox[{"SphericalBesselJ", "[", 
             RowBox[{
              RowBox[{"lTarget", "-", "1"}], ",", 
              RowBox[{
               RowBox[{"Kmom", "[", "z", "]"}], "*", "a"}]}], "]"}], 
            RowBox[{"SphericalHankelH2", "[", 
             RowBox[{"lTarget", ",", 
              RowBox[{"uin", "*", "a"}]}], "]"}]}]}], "&&", " ", 
          RowBox[{
           RowBox[{"-", "40"}], "<=", 
           RowBox[{"Re", "[", "z", "]"}], "<=", "0.01"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"-", "0.01"}], "<=", 
           RowBox[{"Im", "[", "z", "]"}], "<", "40"}]}], ",", 
         RowBox[{"{", "z", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "uout", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TakeLargest", "[", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"OrlovEigenvalues", "[", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"2", "I"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], "]"}], ",",
     "3"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uinRange", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "0.1"}], ",", 
     RowBox[{"-", "10"}], ",", 
     RowBox[{"-", "0.2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RealOrlovEigenvaluesList", "[", 
     RowBox[{"kim_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"TakeLargest", "[", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"OrlovEigenvalues", "[", 
              RowBox[{"k", "+", 
               RowBox[{"kim", "*", "I"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], 
           "]"}], ",", "n"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "uinRange"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EigenvalueCurves", "[", 
   RowBox[{"kim_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pt", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"pt", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "i"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"pt", ",", 
        RowBox[{"RealOrlovEigenvaluesList", "[", 
         RowBox[{"kim", ",", "n"}], "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Curves", "=", 
    RowBox[{"EigenvalueCurves", "[", 
     RowBox[{"0.09990983772868195", ",", "ncurves"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
