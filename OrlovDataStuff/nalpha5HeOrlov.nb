Notebook[{

Cell[CellGroupData[{
Cell["Load Data and Constant Values", "Subtitle",
 CellFrame->{{0, 0}, {0, 0}},
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.9997896448076935`*^9, 3.9997896482868385`*^9}, 
   3.99979003868606*^9},
 Background->RGBColor[
  1, 0.75, 0, 0.33],ExpressionUUID->"89353864-ddd1-104c-b894-89a65f0c75fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Load", " ", "in", " ", "CSV", " ", 
     RowBox[{"(", 
      RowBox[{"Elab", ",", " ", 
       RowBox[{"\[Delta]", " ", 
        RowBox[{"(", "deg", ")"}]}]}], ")"}], " ", "for", " ", 
     RowBox[{"P3", "/", "2"}], " ", "n"}], "+", 
    RowBox[{"4", "He", " ", "Elastic", " ", "Scattering"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Rest", "[", 
      RowBox[{"Import", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], 
           ",", "\"\<nalphaP32.csv\>\""}], "}"}], "]"}], 
        ",", "\"\<Data\>\""}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Constants", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Using", " ", "Nuclear", " ", 
        RowBox[{"Units", ":", "MeV"}]}], ",", "fm", ",", "barns"}], ")"}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hbarc", "=", "197.32698"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"MeV", " ", "fm"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mn", "=", "939.5654"}], ";"}], "           ", 
   RowBox[{"(*", "MeV", "*)"}], "\n", 
   RowBox[{
    RowBox[{"malpha", "=", "3727.3794"}], ";"}], "      ", 
   RowBox[{"(*", "MeV", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mu", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"mn", "*", "malpha"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"mn", "+", "malpha"}], ")"}]}]}], ";"}], " ", 
   RowBox[{"(*", "MeV", "*)"}], "\n", 
   RowBox[{
    RowBox[{"h2m", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"hbarc", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "mu"}], ")"}]}], ")"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"MeV", " ", 
     RowBox[{"fm", "^", "2"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"degToRad", "=", 
     RowBox[{"Pi", "/", "180."}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fm2ToBarn", "=", 
     RowBox[{"1", "/", "100."}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Kimenatic", " ", "Stuff", " ", "and", " ", "Easier", " ", "Bessels"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ecm", "[", "Elab_", "]"}], ":=", 
     RowBox[{"Elab", "*", 
      RowBox[{"(", 
       RowBox[{"malpha", "/", 
        RowBox[{"(", 
         RowBox[{"mn", "+", "malpha"}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"K", "[", "Ecm_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"2.0", "*", "mu", "*", "Ecm"}], "]"}], "/", "hbarc"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"j1", "[", 
      RowBox[{"k_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"SphericalBesselJ", "[", 
      RowBox[{"L", ",", 
       RowBox[{"k", "*", "r"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"n1", "[", 
      RowBox[{"k_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"SphericalBesselY", "[", 
      RowBox[{"L", ",", 
       RowBox[{"k", "*", "r"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"h1", "[", 
      RowBox[{"k_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"SphericalHankelH1", "[", 
      RowBox[{"L", ",", 
       RowBox[{"k", "*", "r"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"h2", "[", 
      RowBox[{"k_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"SphericalHankelH2", "[", 
      RowBox[{"L", ",", 
       RowBox[{"k", "*", "r"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "\[Sigma]", " ", 
     RowBox[{"(", "barns", ")"}], " ", "from", " ", "loaded", " ", "data"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sigmaP32", "[", 
      RowBox[{"Elab_", ",", "deltaDeg_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ecm", ",", "k", ",", "deltaRad"}], "}"}], ",", 
       RowBox[{
        RowBox[{"ecm", "=", 
         RowBox[{"Ecm", "[", "Elab", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"k", "=", 
         RowBox[{"K", "[", "ecm", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"deltaRad", "=", 
         RowBox[{"deltaDeg", "*", "degToRad"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"8.0", "*", 
           RowBox[{"Pi", "/", 
            RowBox[{"k", "^", "2"}]}]}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sin", "[", "deltaRad", "]"}], "^", "2"}], ")"}], "*", 
         "fm2ToBarn"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Create", " ", "list", " ", "of", " ", 
     RowBox[{"(", 
      RowBox[{"Elab", ",", 
       RowBox[{"\[Sigma]", " ", 
        RowBox[{"(", "barns", ")"}]}]}], " "}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmaP32Data", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", 
         RowBox[{"sigmaP32", "[", 
          RowBox[{"#1", ",", "#2"}], "]"}]}], "}"}], "&"}], "@@@", "data"}]}],
     ";"}], "\[LineSeparator]", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"sigmaP32Data", ",", 
     RowBox[{"PlotMarkers", "->", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "8"}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", "Red", "]"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(E\\), \\(n\\)]\\) (MeV)\>\"", 
        ",", "\"\<\\!\\(\\*SubscriptBox[\\(\[Sigma]\\), \\(P3/2\\)]\\) \
(barns)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "20"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "8"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
