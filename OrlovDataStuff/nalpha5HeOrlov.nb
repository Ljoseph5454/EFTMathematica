Cell[CellGroupData[{

Cell["Modeling with Effective Gaussian", "Subtitle",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.99979000161372*^9, 3.9997900252576923`*^9}, 
   3.9997907991462917`*^9, {3.999790916182781*^9, 3.999790932959856*^9}, {
   3.9997912587206345`*^9, 3.9997913772434654`*^9}, {3.9997914235516777`*^9, 
   3.999791428457695*^9}, {3.9997915885356064`*^9, 3.999791646242382*^9}, {
   3.9997919191391735`*^9, 3.999791971121256*^9}, 3.9997929954105015`*^9, 
   3.9997930476931705`*^9},ExpressionUUID->"d4abe2c9-58ec-6b4e-95b0-\
d86e55381c07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Try", " ", "two", " ", "Gaussians"}], ",", " ", 
    RowBox[{"for", " ", "the", " ", "attractive", " ", "well"}], ",", " ", 
    RowBox[{"one", " ", "for", " ", "the", " ", "repulsive", " ", "core"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Veff", "[", 
      RowBox[{"r_", ",", "c1_", ",", "a1_"}], "]"}], ":=", 
     RowBox[{"c1", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "/", "a1"}], ")"}], "^", "2"}]}], "]"}]}]}], ";"}], 
   " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radialODE", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "h2m"}], "*", 
        RowBox[{
         RowBox[{"u", "''"}], "[", "r", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Veff", "[", 
           RowBox[{"r", ",", "c1", ",", "a1"}], "]"}], "+", 
          RowBox[{"h2m", "*", "L", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"L", "+", "1"}], ")"}], "/", 
            RowBox[{"r", "^", "2"}]}]}]}], ")"}], "*", 
        RowBox[{"u", "[", "r", "]"}]}]}], "==", 
      RowBox[{"Ecm", "*", 
       RowBox[{"u", "[", "r", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Boundary", " ", "conditions", " ", "for", " ", "L"}], "=", 
      RowBox[{
       RowBox[{"1", ":", 
        RowBox[{"u", 
         RowBox[{
          RowBox[{
           RowBox[{"(", "r", ")"}], "~", "r"}], "^", 
          RowBox[{"(", 
           RowBox[{"L", "+", "1"}], ")"}]}]}]}], "->", 
       RowBox[{"r", "^", "2"}]}]}], ",", " ", 
     RowBox[{
     "u", " ", "is", " ", "the", " ", "reduced", " ", "radial", " ", 
      "wavefunction"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eps", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "5"}]}]}], ";"}], "        ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Small", " ", "non", " ", "zero", " ", "value", " ", "to", " ", "avoid", " ", 
     RowBox[{"1", "/", 
      RowBox[{"r", "^", "2"}]}], " ", "singularity"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Rmax", "=", "15.0"}], ";"}], "        ", 
   RowBox[{"(*", " ", 
    RowBox[{"Radius", " ", 
     RowBox[{"(", "fm", ")"}], " ", "for", " ", "asymptotic", " ", 
     "matching"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bc", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"u", "[", "eps", "]"}], "==", 
        RowBox[{"eps", "^", "2"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "'"}], "[", "eps", "]"}], "==", 
        RowBox[{"2", "*", "eps"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "ParametricNDSolveValue", " ", "creates", " ", "a", " ", "compiled", " ", 
     "function", " ", "which", " ", "takes", " ", 
     RowBox[{"{", 
      RowBox[{"Ecm", ",", "c1", ",", "a1", ",", "c2", ",", "a2"}], "}"}], " ",
      "and", " ", "outputs", " ", "the", " ", "wave", " ", "function", " ", 
     "u", " ", "and", " ", "its", " ", "derivative", " ", 
     RowBox[{"u", "'"}], " ", "at", " ", "Rmax"}], " ", "*)"}], 
   RowBox[{
    RowBox[{"solveWaveFunction", "=", 
     RowBox[{"ParametricNDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"radialODE", ",", "bc"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"u", "[", "Rmax", "]"}], ",", 
         RowBox[{
          RowBox[{"u", "'"}], "[", "Rmax", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "eps", ",", "Rmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Ecm", ",", "c1", ",", "a1"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}], ",", 
       RowBox[{"MaxSteps", "->", "50000"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Define", " ", "the", " ", "exact", " ", "asymptotic", " ", "free", " ", 
      "solutions"}], ",", " ", 
     RowBox[{"call", " ", "them", " ", "J", " ", "and", " ", "Y"}], ",", " ", 
     RowBox[{"and", " ", "their", " ", "derivatives"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"J", "[", 
     RowBox[{"k_", ",", "r_"}], "]"}], ":=", 
    RowBox[{"r", "*", 
     RowBox[{"j1", "[", 
      RowBox[{"k", ",", "r"}], "]"}]}]}], "\n", 
   RowBox[{
    RowBox[{"Y", "[", 
     RowBox[{"k_", ",", "r_"}], "]"}], ":=", 
    RowBox[{"r", "*", 
     RowBox[{"n1", "[", 
      RowBox[{"k", ",", "r"}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Jprime", "[", 
     RowBox[{"k_", ",", "r_"}], "]"}], ":=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"r", "*", 
        RowBox[{"j1", "[", 
         RowBox[{"k", ",", "r"}], "]"}]}], ",", "r"}], "]"}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"Yprime", "[", 
     RowBox[{"k_", ",", "r_"}], "]"}], ":=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"r", "*", 
        RowBox[{"n1", "[", 
         RowBox[{"k", ",", "r"}], "]"}]}], ",", "r"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Extract", " ", "Phase", " ", "Shift", " ", "in", " ", "Degrees"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhaseShift", "[", 
     RowBox[{
      RowBox[{"Ecm_", "?", "NumericQ"}], ",", 
      RowBox[{"c1_", "?", "NumericQ"}], ",", 
      RowBox[{"a1_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "uR", ",", "uprimeR", ",", "gamma", ",", "currentK", ",", "Jval", ",", 
        "Yval", ",", "Jpval", ",", "Ypval", ",", "num", ",", "den", ",", 
        "delta"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"uR", ",", "uprimeR"}], "}"}], "=", 
        RowBox[{"solveWaveFunction", "[", 
         RowBox[{"Ecm", ",", "c1", ",", "a1"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "1.", " ", "Get", " ", "the", " ", "numerical", " ", "wavefunction", " ",
          "and", " ", "derivative", " ", "at", " ", "Rmax"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"gamma", "=", 
        RowBox[{"uprimeR", "/", "uR"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Compute", " ", "the", " ", "numerical", " ", 
         "logarithmic", " ", "derivative"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"currentK", "=", 
        RowBox[{"K", "[", "Ecm", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Jval", "=", 
        RowBox[{"J", "[", 
         RowBox[{"currentK", ",", "Rmax"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "3.", " ", "Evaluate", " ", "exact", " ", "analytical", " ", "Bessel",
          " ", "functions", " ", "at", " ", "Rmax"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Yval", "=", 
        RowBox[{"Y", "[", 
         RowBox[{"currentK", ",", "Rmax"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Jpval", "=", 
        RowBox[{"Jprime", "[", 
         RowBox[{"currentK", ",", "Rmax"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Ypval", "=", 
        RowBox[{"Yprime", "[", 
         RowBox[{"currentK", ",", "Rmax"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"num", "=", 
        RowBox[{"Jpval", "-", 
         RowBox[{"gamma", "*", "Jval"}]}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"4.", " ", "Compute", " ", "tan", 
         RowBox[{"(", "delta", ")"}], " ", "components"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"den", "=", 
        RowBox[{"Ypval", "-", 
         RowBox[{"gamma", "*", "Yval"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"delta", "=", 
        RowBox[{
         RowBox[{"ArcTan", "[", 
          RowBox[{"den", ",", "num"}], "]"}], "*", 
         RowBox[{"180", "/", "Pi"}]}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"5.", " ", "Get", " ", "angle", " ", "using", " ", 
          RowBox[{"ArcTan", "[", 
           RowBox[{"x", ",", "y"}], "]"}], " ", "to", " ", "get", " ", "the", 
          " ", "correct", " ", "quadrant"}], ",", " ", 
         RowBox[{"convert", " ", "to", " ", "degrees"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"delta", "<", "0"}], ",", 
         RowBox[{"delta", "=", 
          RowBox[{"delta", "+", "180"}]}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"Keep", " ", "phase", " ", "shift", " ", "strictly", " ", 
         RowBox[{"positive", "/", "continuous"}], " ", "for", " ", 
         "plotting"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "delta", "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{
  3.9997919516886406`*^9, {3.999792020956976*^9, 3.999792130752617*^9}, {
   3.999792171315634*^9, 3.9997921897705116`*^9}, {3.9997922559328003`*^9, 
   3.9997922687169247`*^9}, {3.999792304850359*^9, 3.9997923900653915`*^9}, {
   3.9997924929297543`*^9, 3.9997925628367424`*^9}, {3.9997926217640343`*^9, 
   3.9997926233777905`*^9}, {3.9997928543124657`*^9, 3.999792863685316*^9}, 
   3.9997929954105015`*^9, 3.9997940882896404`*^9, {3.999794120396141*^9, 
   3.999794165776499*^9}, {3.9997956632290936`*^9, 3.9997956660194187`*^9}, {
   3.9997974861812725`*^9, 3.9997975254996357`*^9}, {3.99979815312545*^9, 
   3.9997981799872055`*^9}, {3.999798323480116*^9, 3.9997983877707977`*^9}},
 CellLabel->
  "In[408]:=",ExpressionUUID->"2fa9f8e1-99ef-ce40-99f7-952e98e60251"]
}, Closed]],

Cell[CellGroupData[{

Cell["Optimize to fit Data", "Subtitle",
 CellChangeTimes->{{3.9997930032014713`*^9, 
  3.999793017905718*^9}},ExpressionUUID->"bfb88335-ab02-b742-8b18-\
f9b50dd731f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "a", " ", "Chi"}], "-", 
    RowBox[{"Squared", " ", "Error", " ", "Function"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ChiSquared", "[", 
      RowBox[{
       RowBox[{"c1_", "?", "NumericQ"}], ",", 
       RowBox[{"a1_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"PhaseShift", "[", 
           RowBox[{
            RowBox[{"pt", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "c1", ",", "a1"}], "]"}], "-", 
          RowBox[{"pt", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"pt", ",", "data"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initialize", " ", "a", " ", "tracker", " ", "variable"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"currentStatus", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<c1\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<a1\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<Chi2\>\"", "->", "0"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", " ", "a", " ", "live"}], "-", 
     RowBox[{"updating", " ", "display"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Dynamic", "[", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"List", "@@@", "currentStatus"}], ",", 
        RowBox[{"Frame", "->", "All"}]}], "]"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "1.", " ", "Define", " ", "HARD", " ", "physical", " ", "constraints"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"constraints", "=", 
     RowBox[{
      RowBox[{"c1", "<", "0"}], "&&", 
      RowBox[{"1.0", "<=", "a1", "<=", "5.0"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "depth", " ", "must", " ", "be", " ", "attractive", " ", 
      RowBox[{"(", "negative", ")"}]}], ",", 
     RowBox[{
      RowBox[{"and", " ", "the", " ", "range", " ", "strictly"}], "<", 
      RowBox[{"5", " ", "fm", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"resonance", " ", 
          RowBox[{"is", " ", "~", "1"}]}], "-", 
         RowBox[{"2", "fm"}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Run", " ", "the", " ", "Optimizer"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"bestFit", "=", 
    RowBox[{"NMinimize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ChiSquared", "[", 
         RowBox[{"c1", ",", "a1"}], "]"}], ",", "constraints"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c1", ",", 
          RowBox[{"-", "80.0"}], ",", 
          RowBox[{"-", "20.0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "1.0", ",", "4.0"}], "}"}]}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<NelderMead\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"EvaluationMonitor", ":>", 
       RowBox[{"(", 
        RowBox[{"currentStatus", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<c1\>\"", "->", "c1"}], ",", 
           RowBox[{"\"\<a1\>\"", "->", "a1"}], ",", 
           RowBox[{"\"\<Chi2\>\"", "->", 
            RowBox[{"ChiSquared", "[", 
             RowBox[{"c1", ",", "a1"}], "]"}]}]}], "}"}]}], ")"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "best", " ", "parameters"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c1Fit", ",", "a1Fit"}], "}"}], "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c1", ",", "a1"}], "}"}], "/.", " ", 
      RowBox[{"bestFit", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.999792918751152*^9, 3.9997929716370277`*^9}, {
  3.9997931516089897`*^9, 3.9997932035041084`*^9}, {3.999793374088581*^9, 
  3.999793394344532*^9}, {3.999793797445673*^9, 3.999793822124569*^9}, {
