Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "the", " ", 
    RowBox[{"Victory", "!"}]}], "*)"}], "\[IndentingNewLine]", 
