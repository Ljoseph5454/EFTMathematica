Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Find", " ", "the", " ", "Resonance", " ", "Pole", " ", "in", " ", "the", " ",
     "Lower", " ", "Half", " ", "Plane"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Searching the UHP for the resonance momentum...\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "guess", " ", "in", " ", 
     RowBox[{"UHP", ":", 
      RowBox[{
       RowBox[{"k", "~", 
        RowBox[{"-", "0.2"}]}], "+", 
       RowBox[{"0.1", " ", "I"}]}]}]}], " ", "*)"}], 
   RowBox[{
    RowBox[{"kRoot", "=", 
     RowBox[{"k", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"PoleCondition", "[", "k", "]"}], "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{
           RowBox[{"-", "0.24"}], "+", 
           RowBox[{"0.06", " ", "I"}]}]}], "}"}], ",", 
        RowBox[{"Evaluated", "->", "False"}], ",", 
        RowBox[{"AccuracyGoal", "->", "6"}], ",", 
        RowBox[{"PrecisionGoal", "->", "6"}]}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Momentum Found: \>\"", ",", "kRoot"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Physical Resonance Energy (MeV): \>\"", ",", 
      RowBox[{"h2m", "*", 
       RowBox[{"kRoot", "^", "2"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "7.", " ", "Extract", " ", "the", " ", "exact", " ", "Orlovian", " ", 
     "Radial", " ", "Resonance", " ", "State"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"FinalOrlovianState", "[", "r_", "]"}], ":=", 
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"\[CapitalLambda]", "[", 
        RowBox[{"-", "kRoot"}], "]"}], "*", 
       RowBox[{
        RowBox[{"SolveW", "[", 
         RowBox[{"-", "kRoot"}], "]"}], "[", "r", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "the", " ", "magnitude", " ", "of", " ", "the", " ", 
     "Orlovian", " ", "Bound", " ", "State", " ", "to", " ", "verify", " ", 
     "exponential", " ", "decay"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
