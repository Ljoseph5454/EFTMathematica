Cell[CellGroupData[{

Cell["Analytic Continuation to Extract Pole", "Subtitle",
 CellChangeTimes->{{3.999794909954529*^9, 
  3.999794921760084*^9}},ExpressionUUID->"25d36b7b-a348-7841-aaa0-\
b10212f527a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"VeffFit", "[", "r_", "]"}], ":=", 
    RowBox[{"Veff", "[", 
     RowBox[{"r", ",", "c1Fit", ",", "a1Fit"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Redefined", " ", "potential", " ", "with", " ", "fit", " ", 
    "parameters"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Vlonshell", "[", "k_", "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "^", "2"}], "*", 
        RowBox[{
         RowBox[{"j1", "[", 
          RowBox[{"k", ",", "r"}], "]"}], "^", "2"}], "*", 
        RowBox[{"VeffFit", "[", "r", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "eps", ",", "Rmax"}], "}"}]}], "]"}]}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{"V_l", 
    RowBox[{"(", 
     RowBox[{"k", ",", "k"}], ")"}], " ", "in", " ", 
    RowBox[{"paper", "'"}], "s", " ", "conventions"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalLambda]", "[", "k_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"I", "*", "2", "*", "Pi", "*", "mu", "*", "k"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"I", "*", "8", "*", 
        RowBox[{"Pi", "^", "2"}], "*", "mu", "*", "k", "*", 
        RowBox[{"Vlonshell", "[", "k", "]"}]}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "\[CapitalLambda]", " ", "factor", " ", "as", " ", "defined", " ", "in", " ",
     "paper"}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"IVP", " ", "Superposition", " ", "Solver", " ", "for", " ", "w", 
      RowBox[{"(", "r", ")"}]}], "=", 
     RowBox[{
      RowBox[{"G_V", " ", "V"}], "|", 
      RowBox[{"k", ">"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "this", " ", "computes", " ", "the", " ", "solution", " ", "to", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"H_", "0"}], "+", "V", "-", "E"}], ")"}], "w", 
      RowBox[{"(", "r", ")"}]}], "=", 
     RowBox[{
      RowBox[{"-", "V"}], 
      RowBox[{"(", "r", ")"}], " ", "r", " ", "j_", "1", 
      RowBox[{"(", "kr", ")"}]}]}]}], " ", "*)"}], 
  RowBox[{
   RowBox[{"SolveW", "[", 
    RowBox[{"k_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Ecm", ",", "ODEreg", ",", "ODEp", ",", "ureg", ",", "up", ",", 
       "gammaOut", ",", "Creg"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Ecm", "=", 
       RowBox[{"h2m", "*", 
        RowBox[{"k", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ODEreg", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "h2m"}], "*", 
          RowBox[{
           RowBox[{"u", "''"}], "[", "r", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"VeffFit", "[", "r", "]"}], "+", 
            RowBox[{"L", "*", 
             RowBox[{"(", 
              RowBox[{"L", "+", "1"}], ")"}], "*", 
             RowBox[{"h2m", "/", 
              RowBox[{"r", "^", "2"}]}]}], "-", "Ecm"}], ")"}], "*", 
          RowBox[{"u", "[", "r", "]"}]}]}], "==", "0"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "1.", " ", "Solve", " ", "the", " ", "Homogeneous", " ", "Equation"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ureg", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ODEreg", ",", 
           RowBox[{
            RowBox[{"u", "[", "eps", "]"}], "==", 
            RowBox[{"eps", "^", 
             RowBox[{"(", 
              RowBox[{"L", "+", "1"}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"u", "'"}], "[", "eps", "]"}], "==", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"L", "+", "1"}], ")"}], "*", 
             RowBox[{"eps", "^", "L"}]}]}]}], "}"}], ",", "u", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "eps", ",", "Rmax"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ODEp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "h2m"}], "*", 
          RowBox[{
           RowBox[{"p", "''"}], "[", "r", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"VeffFit", "[", "r", "]"}], "+", 
            RowBox[{"L", "*", 
             RowBox[{"(", 
              RowBox[{"L", "+", "1"}], ")"}], "*", 
             RowBox[{"h2m", "/", 
              RowBox[{"r", "^", "2"}]}]}], "-", "Ecm"}], ")"}], "*", 
          RowBox[{"p", "[", "r", "]"}]}]}], "==", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"VeffFit", "[", "r", "]"}]}], "*", 
         RowBox[{"J", "[", 
          RowBox[{"k", ",", "r"}], "]"}]}]}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", "Solve", " ", "Inhomogeneous", " ", "Equation"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"up", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ODEp", ",", 
           RowBox[{
            RowBox[{"p", "[", "eps", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"p", "'"}], "[", "eps", "]"}], "==", "0"}]}], "}"}], ",",
          "p", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "eps", ",", "Rmax"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gammaOut", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"r", "*", 
            RowBox[{"h1", "[", 
             RowBox[{"k", ",", "r"}], "]"}]}], ",", "r"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"r", "*", 
           RowBox[{"h1", "[", 
            RowBox[{"k", ",", "r"}], "]"}]}], ")"}]}], "/.", " ", 
        RowBox[{"r", "->", "Rmax"}]}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "3.", " ", "Enforce", " ", "Outgoing", " ", "Robin", " ", "Boundary", " ",
         "Condition", " ", "at", " ", "Rmax"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Creg", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"up", "'"}], "[", "Rmax", "]"}], "-", 
           RowBox[{"gammaOut", "*", 
            RowBox[{"up", "[", "Rmax", "]"}]}]}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"ureg", "'"}], "[", "Rmax", "]"}], "-", 
          RowBox[{"gammaOut", "*", 
           RowBox[{"ureg", "[", "Rmax", "]"}]}]}], ")"}]}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"4.", " ", "Calculate", " ", 
        RowBox[{"coeff", ".", " ", "of"}], " ", "regular", " ", "part"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Function", "[", 
       RowBox[{"r", ",", 
        RowBox[{
         RowBox[{"up", "[", "r", "]"}], "+", 
         RowBox[{"Creg", "*", 
          RowBox[{"ureg", "[", "r", "]"}]}]}]}], "]"}]}]}], 
    RowBox[{"(*", 
     RowBox[{"Return", " ", "the", " ", "wavefunction", " ", "w", 
      RowBox[{"(", "r", ")"}]}], "*)"}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Evaluate", " ", "the", " ", "Matrix", " ", "Element"}], "<", 
     "k"}], "|", 
    RowBox[{"V", " ", "G_V", " ", "V"}], "|", 
    RowBox[{"k", ">"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MatrixElement", "[", 
    RowBox[{"k_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "wFunc", "}"}], ",", 
     RowBox[{
      RowBox[{"wFunc", "=", 
       RowBox[{"SolveW", "[", "k", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"Pi", "^", "2"}]}], ")"}]}], ")"}], "*", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"VeffFit", "[", "r", "]"}], "*", 
          RowBox[{"J", "[", 
           RowBox[{"k", ",", "r"}], "]"}], "*", 
          RowBox[{"wFunc", "[", "r", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "eps", ",", "Rmax"}], "}"}]}], "]"}]}]}]}], 
    "]"}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Constraint", " ", "Condition", " ", "for", " ", "Finding", " ", "k_"}], 
    "\[Star]"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PoleCondition", "[", 
    RowBox[{"k_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"\[CapitalLambda]", "[", "k", "]"}], "*", 
     RowBox[{"MatrixElement", "[", "k", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
