     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}], " ", ",", 
        RowBox[{"{", "Dotted", "}"}]}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Solid=Exact T, Dashed=Factorized T\>\""}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
