Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Try", " ", "to", " ", "include", " ", "Born", " ", "term"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TBorn", "[", 
     RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "V0"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "\[Mu]"}], ")"}]}], ")"}], 
     RowBox[{"J", "[", 
      RowBox[{"p", ",", "q"}], "]"}]}]}], "\[IndentingNewLine]", 
