Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Try", " ", "to", " ", "Numerically", " ", "Normalize"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"PsiUInside", "[", 
     RowBox[{"r_", ",", "u_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "[", "u", "]"}], 
      RowBox[{"SphericalBesselJ", "[", 
       RowBox[{"1", ",", 
        RowBox[{
         RowBox[{"K", "[", "u", "]"}], "*", "r"}]}], "]"}]}], "+", 
     RowBox[{"SphericalBesselJ", "[", 
      RowBox[{"1", ",", 
       RowBox[{"u", "*", "r"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PsiUOutside", "[", 
     RowBox[{"r_", ",", "u_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"PsiUInside", "[", 
        RowBox[{"a", ",", "u"}], "]"}], "/", 
       RowBox[{"SphericalHankelH1", "[", 
        RowBox[{"1", ",", 
         RowBox[{"u", "*", "a"}]}], "]"}]}], ")"}], 
     RowBox[{"SphericalHankelH1", "[", 
      RowBox[{"1", ",", 
       RowBox[{"u", "*", "r"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"<", "Psi"}], "|", 
     RowBox[{"Psi", ">", " ", 
      RowBox[{
      "for", " ", "inner", " ", "and", " ", "outer", " ", "parts"}]}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NormInsideNumerical", "[", "u_", "]"}], ":=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "^", "2"}], "*", 
       RowBox[{
        RowBox[{"PsiUInside", "[", 
         RowBox[{"r", ",", "u"}], "]"}], "^", "2"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "a"}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NormOutsideNumerical", "[", "u_", "]"}], ":=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "^", "2"}], "*", 
       RowBox[{
        RowBox[{"PsiUOutside", "[", 
         RowBox[{"r", ",", "u"}], "]"}], "^", "2"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "a", ",", "Infinity"}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"d", "/", "dv"}], "<", "Psi"}], "|", 
     RowBox[{"U", 
      RowBox[{"(", "v", ")"}]}], "|", 
     RowBox[{"psi", ">", " ", 
      RowBox[{"(", 
       RowBox[{
       "only", " ", "the", " ", "seperable", " ", "part", " ", "of", " ", "U",
         " ", "depends", " ", "on", " ", "v"}], ")"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Compute", " ", "<", "v"}], "|", "V", "|", 
     RowBox[{"psi", ">"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"overlap", "[", 
     RowBox[{
      RowBox[{"v_", "?", "NumericQ"}], ",", "u_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "V0"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "\[Mu]"}], ")"}]}], ")"}], "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "/", "Pi"}], "]"}], "*", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "^", "2"}], "*", 
        RowBox[{"PsiUInside", "[", 
         RowBox[{"r", ",", "u"}], "]"}], "*", 
        RowBox[{"SphericalBesselJ", "[", 
         RowBox[{"1", ",", 
          RowBox[{"v", "*", "r"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "a"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "the", " ", "seperable", " ", "piece"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"matrixElement", "[", 
     RowBox[{
      RowBox[{"v_", "?", "NumericQ"}], ",", "u_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"\[CapitalLambda]", "[", "v", "]"}], "*", 
     RowBox[{
      RowBox[{"overlap", "[", 
       RowBox[{"v", ",", "u"}], "]"}], "^", "2"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Compute", " ", "the", " ", "derivative", " ", "to", " ", "give", " ", 
     "the", " ", "norm"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Needs", "[", "\"\<NumericalCalculus`\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DerivativeNormNumerical", "[", "u_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Mu]", "/", "u"}], ")"}], "*", 
     RowBox[{"ND", "[", 
      RowBox[{
       RowBox[{"matrixElement", "[", 
        RowBox[{"v", ",", "u"}], "]"}], ",", "v", ",", "u"}], "]"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Total", " ", "Norm"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TotalNormNumerical", "[", "u_", "]"}], ":=", 
    RowBox[{
     RowBox[{"NormInsideNumerical", "[", "u", "]"}], "+", 
     RowBox[{"NormOutsideNumerical", "[", "u", "]"}], "-", 
     RowBox[{"DerivativeNormNumerical", "[", "u", "]"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TFactorizedNumerical", "[", 
      RowBox[{"p_", ",", "q_", ",", "u_", ",", "ures_"}], "]"}], ":=", 
     RowBox[{"2", "\[Mu]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalGamma]", "[", 
          RowBox[{"p", ",", 
           RowBox[{"-", "kres"}]}], "]"}], "*", 
         RowBox[{"\[CapitalGamma]", "[", 
          RowBox[{"q", ",", 
           RowBox[{"-", "kres"}]}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ures", "^", "2"}], "-", 
         RowBox[{"u", "^", "2"}]}], ")"}]}], "*", 
      RowBox[{"1", "/", 
       RowBox[{"TotalNormNumerical", "[", 
        RowBox[{"-", "kres"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"AbsArgPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TExact", "[", 
        RowBox[{"k", ",", "k", ",", "k"}], "]"}], ",", 
       RowBox[{"TFactorizedNumerical", "[", 
        RowBox[{"k", ",", "k", ",", "k", ",", "kres"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}]}], " ", "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Solid=Exact T, Dashed=Factorized T\>\""}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9829341190384007`*^9, 3.9829342222524567`*^9}, {
  3.982934267735895*^9, 3.9829342941522236`*^9}, {3.9829343284652157`*^9, 
  3.982934549237831*^9}, {3.9829345807680492`*^9, 3.9829347979860935`*^9}, {
  3.982934848625414*^9, 3.9829348510128536`*^9}, {3.982934888970684*^9, 
  3.982934922491846*^9}, {3.9829378571237144`*^9, 3.9829378619441776`*^9}},
 CellLabel->
  "In[374]:=",ExpressionUUID->"58dcdad9-f45a-4244-b25d-49c1734a90f8"],

