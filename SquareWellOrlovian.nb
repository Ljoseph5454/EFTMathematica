Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Construct", " ", "the", " ", "cross", " ", "section", " ", "by", " ", 
     "first", " ", "getting", " ", "the", " ", "inverse", " ", "K", " ", 
     "matrix"}], ",", " ", 
    RowBox[{"then", " ", "making", " ", "XS", " ", "from", " ", "that"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"KMatrixInverseFactorized", "[", "u_", "]"}], ":=", 
    RowBox[{"Re", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"TFactorizedNumerical", "[", 
        RowBox[{"u", ",", "u", ",", "u", ",", "kres"}], "]"}], ")"}]}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KMatrixFactorized", "[", "u_", "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"KMatrixInverseFactorized", "[", "u", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XSKMatrixFactorized", "[", "u_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"64", " ", 
        RowBox[{"Pi", "^", "5"}], " ", 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"2", "+", "1"}], ")"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", 
          RowBox[{"Pi", "/", 
           RowBox[{"p", "^", "2"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "L"}], "+", "1"}], ")"}]}], "*)"}], "*", 
      RowBox[{
       RowBox[{
        RowBox[{"KMatrixFactorized", "[", "u", "]"}], "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"4", "*", 
            RowBox[{"Pi", "^", "2"}], "*", "\[Mu]", "*", "u", "*", 
            RowBox[{"KMatrixFactorized", "[", "u", "]"}]}], ")"}], "^", 
          "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Exact", " ", "cross", " ", "section"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XS", "[", "u_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"64", 
        RowBox[{"Pi", "^", "5"}], 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"2", "+", "1"}], ")"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"TExact", "[", 
         RowBox[{"u", ",", "u", ",", "u"}], "]"}], "]"}], "^", "2"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"XS", "[", "z", "]"}], ",", 
       RowBox[{"XSKMatrixFactorized", "[", "z", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0.25", ",", "3"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Exact\>\"", ",", "\"\<Factorized\>\""}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9829356242032833`*^9, 3.9829356772599144`*^9}, {
  3.982935772121624*^9, 3.982935985709385*^9}, {3.9829364278622265`*^9, 
  3.98293642837381*^9}, {3.982936579023506*^9, 3.9829365843126297`*^9}, {
  3.98293680108461*^9, 3.9829368026955986`*^9}},
 CellLabel->
  "In[385]:=",ExpressionUUID->"680e6aab-62b8-9f4b-8ada-16f519c88344"],

