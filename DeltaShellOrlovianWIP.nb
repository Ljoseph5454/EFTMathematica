Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Try", " ", "to", " ", "work", " ", "in", " ", "Position", " ", "Space", " ", 
    RowBox[{"(", 
     RowBox[{"with", " ", "reduced", " ", "wavefunction", " ", 
      RowBox[{"chi", "!!"}]}], ")"}], " ", "and", " ", "Numerically", " ", 
    "Normalize"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ChiUInside", "[", 
     RowBox[{"r_", ",", "u_"}], "]"}], ":=", 
    RowBox[{"r", "*", 
     RowBox[{"SphericalBesselJ", "[", 
      RowBox[{"l", ",", 
       RowBox[{"u", "*", "r"}]}], "]"}], "*", 
