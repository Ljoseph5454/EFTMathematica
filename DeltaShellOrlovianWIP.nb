Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Try", " ", "to", " ", "include", " ", "the", " ", "\"\<hard sphere\>\"", 
     " ", "term", " ", "that", " ", "you", " ", "get", " ", "via", " ", 
     "Hadamards", " ", 
     RowBox[{"factorization", ".", " ", "i", ".", "e", ".", " ", "S"}]}], " ",
     "=", " ", 
    RowBox[{"S_hs", " ", "*", " ", 
     RowBox[{"(", 
      RowBox[{"pole", " ", "stuff"}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Shs", "[", "p_", "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"SphericalHankelH2", "[", 
       RowBox[{"1", ",", 
        RowBox[{"p", "*", "a"}]}], "]"}]}], "/", 
     RowBox[{"SphericalHankelH1", "[", 
      RowBox[{"1", ",", 
       RowBox[{"p", "*", "a"}]}], "]"}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"Shs", "=", 
     RowBox[{"e", "^", 
      RowBox[{"(", 
       RowBox[{"2", "idelta_hs", 
        RowBox[{"(", "k", ")"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ths", "[", "p_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Shs", "[", "p", "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"8", "*", 
       RowBox[{"Pi", "^", "2"}], "*", "I", "*", "\[Mu]", "*", "p"}], 
      ")"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deltabg", "[", "p_", "]"}], ":=", 
    RowBox[{"ArcTan", "[", 
     RowBox[{
      RowBox[{"SphericalBesselJ", "[", 
       RowBox[{"l", ",", 
        RowBox[{"a", "*", "p"}]}], "]"}], "/", 
      RowBox[{"SphericalBesselY", "[", 
       RowBox[{"l", ",", 
        RowBox[{"a", "*", "p"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sbg", "[", "p_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"2", "*", "I", "*", 
      RowBox[{"deltabg", "[", "p", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tbg", "[", "p_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"deltabg", "[", "p", "]"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", "*", 
       RowBox[{"deltabg", "[", "p", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"AbsArgPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TExact", "[", 
        RowBox[{"k", ",", "k", ",", "k"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Ths", "[", "k", "]"}], "+", 
        RowBox[{
         RowBox[{"Shs", "[", "k", "]"}], "*", 
         RowBox[{"TFactorizedNumerical", "[", 
          RowBox[{"k", ",", "k", ",", "k", ",", "kres"}], "]"}]}]}], ",", 
       RowBox[{"TFactorizedNumerical", "[", 
        RowBox[{"k", ",", "k", ",", "k", ",", "kres"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}], " ", ",", 
        RowBox[{"{", "Dotted", "}"}]}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Solid=Exact T, Dashed=Factorized T + Hard Sphere, \
Dotted=Factorized T\>\""}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.983888254185364*^9, 3.9838883462106915`*^9}, {
  3.9838883933972225`*^9, 3.9838884493381767`*^9}, {3.983888517840872*^9, 
