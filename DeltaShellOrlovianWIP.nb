Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Some", " ", "Graphing", " ", "Tools"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"myTicks", "[", 
     RowBox[{"min_", ",", "max_", ",", "spacing_", ",", "nminor_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"minorSpacing", "=", 
         RowBox[{"spacing", "/", 
          RowBox[{"(", 
           RowBox[{"nminor", "+", "1"}], ")"}]}]}], ",", "majorVals", ",", 
        "minorVals", ",", 
        RowBox[{"eps", "=", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "7"}]}], " ", "spacing"}]}]}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"Generate", " ", "Major", " ", "Ticks"}], "*)"}], 
      RowBox[{
       RowBox[{"majorVals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "i", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"Infinity", ",", "2"}], "}"}], ",", 
              RowBox[{"NumberPadding", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<\>\"", ",", "\"\<0\>\""}], "}"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.02", ",", "0"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"Ceiling", "[", 
              RowBox[{"min", "/", "spacing"}], "]"}], "*", "spacing"}], ",", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{"max", "/", "spacing"}], "]"}], "*", "spacing"}], ",", 
            "spacing"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Generate", " ", "Minor", " ", "Ticks"}], ",", 
         RowBox[{
          RowBox[{"filtering", " ", "near"}], "-", 
          RowBox[{
          "coincident", " ", "major", " ", "tick", " ", "positions"}]}]}], 
        "*)"}], 
       RowBox[{"minorVals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"j", ",", "\"\<\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"0.01", ",", "0"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{
             RowBox[{"Ceiling", "[", 
              RowBox[{"min", "/", "minorSpacing"}], "]"}], "*", 
             "minorSpacing"}], ",", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{"max", "/", "minorSpacing"}], "]"}], "*", 
             "minorSpacing"}], ",", "minorSpacing"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minorVals", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"minorVals", ",", 
          RowBox[{"Function", "[", 
           RowBox[{"tick", ",", 
            RowBox[{"NoneTrue", "[", 
             RowBox[{
              RowBox[{"majorVals", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"#", "-", 
                  RowBox[{"tick", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "<", "eps"}], 
               "&"}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{"majorVals", ",", "minorVals"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], 
