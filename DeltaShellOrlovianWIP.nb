Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Try", " ", "to", " ", "include", " ", "Born", " ", "term"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TBorn", "[", 
     RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "V0"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "\[Mu]"}], ")"}]}], ")"}], 
     RowBox[{"J", "[", 
      RowBox[{"p", ",", "q"}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SBorn", "[", 
     RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"8", "*", 
      RowBox[{"Pi", "^", "2"}], "*", "I", "*", "\[Mu]", "*", "p", "*", 
      RowBox[{"TBorn", "[", 
       RowBox[{"p", ",", "q"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"AbsArgPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TExact", "[", 
        RowBox[{"k", ",", "k", ",", "k"}], "]"}], ",", 
       RowBox[{
        RowBox[{"TBorn", "[", 
         RowBox[{"k", ",", "k"}], "]"}], "+", 
        RowBox[{
         RowBox[{"SBorn", "[", 
          RowBox[{"k", ",", "k"}], "]"}], "*", 
         RowBox[{"TFactorizedNumerical", "[", 
          RowBox[{"k", ",", "k", ",", "k", ",", "kres"}], "]"}]}]}], ",", 
       RowBox[{"TFactorizedNumerical", "[", 
        RowBox[{"k", ",", "k", ",", "k", ",", "kres"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}], " ", ",", 
        RowBox[{"{", "Dotted", "}"}]}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Solid=Exact T, Dashed=Factorized T\>\""}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
