Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Construct", " ", "the", " ", "cross", " ", "section", " ", "by", " ", 
     "first", " ", "getting", " ", "the", " ", "inverse", " ", "K", " ", 
     "matrix"}], ",", " ", 
    RowBox[{"then", " ", "making", " ", "XS", " ", "from", " ", "that"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"KMatrixInverseFactorized", "[", "u_", "]"}], ":=", 
    RowBox[{"Re", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"TFactorizedNumerical", "[", 
        RowBox[{"u", ",", "u", ",", "u", ",", "kres"}], "]"}], ")"}]}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KMatrixFactorized", "[", "u_", "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"KMatrixInverseFactorized", "[", "u", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XSKMatrixFactorized", "[", "u_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"64", " ", 
        RowBox[{"Pi", "^", "5"}], " ", 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"2", "+", "1"}], ")"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", 
          RowBox[{"Pi", "/", 
           RowBox[{"p", "^", "2"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "L"}], "+", "1"}], ")"}]}], "*)"}], "*", 
      RowBox[{
       RowBox[{
        RowBox[{"KMatrixFactorized", "[", "u", "]"}], "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"4", "*", 
            RowBox[{"Pi", "^", "2"}], "*", "\[Mu]", "*", "u", "*", 
            RowBox[{"KMatrixFactorized", "[", "u", "]"}]}], ")"}], "^", 
          "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Exact", " ", "cross", " ", "section"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XS", "[", "u_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"64", 
        RowBox[{"Pi", "^", "5"}], 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"2", "+", "1"}], ")"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"TExact", "[", 
         RowBox[{"u", ",", "u", ",", "u"}], "]"}], "]"}], "^", "2"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XSFactorized", "[", "u_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"64", 
        RowBox[{"Pi", "^", "5"}], 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"2", "+", "1"}], ")"}], "*", 
      RowBox[{
