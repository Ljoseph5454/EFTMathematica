      RowBox[{"(", 
       RowBox[{"64", 
        RowBox[{"Pi", "^", "5"}], 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "L"}], "+", "1"}], ")"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"T", "[", 
         RowBox[{"g", ",", "L", ",", "u", ",", "u", ",", "u"}], "]"}], "]"}], 
       "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XSFactorized", "[", 
      RowBox[{"g_", ",", "L_", ",", "u_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"64", 
        RowBox[{"Pi", "^", "5"}], 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "L"}], "+", "1"}], ")"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"TFactorized", "[", 
         RowBox[{"g", ",", "L", ",", "u", ",", "u", ",", "u"}], "]"}], "]"}], 
       "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BW", "[", 
      RowBox[{"g_", ",", "L_", ",", "u_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", 
        RowBox[{"Pi", "/", 
         RowBox[{"u", "^", "2"}]}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "L"}], "+", "1"}], ")"}], "*", 
      RowBox[{
       RowBox[{
        RowBox[{"Im", "[", "Eres", "]"}], "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"u", "^", "2"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "\[Mu]"}], ")"}]}], "-", 
            RowBox[{"Re", "[", "Eres", "]"}]}], ")"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"Im", "[", "Eres", "]"}], "^", "2"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Find", " ", "the", " ", "Taylor", " ", "Expansion", " ", "Coefficients", 
     " ", 
     RowBox[{"(", 
      RowBox[{
      "currently", " ", "up", " ", "to", " ", "2", "nd", " ", "order"}], 
      ")"}], " ", "and", " ", "Define", " ", "Modified", " ", "XS", " ", "up",
      " ", "to", " ", "1", "st", " ", "and", " ", "2", "nd", " ", "Order"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"PsiUTilde", "[", 
           RowBox[{"\[Lambda]", ",", "l", ",", "kres", ",", "z"}], "]"}], ",",
           "z"}], "]"}], "/.", 
        RowBox[{"z", "->", "kres"}]}], ")"}], "/", 
      RowBox[{"PsiUTilde", "[", 
       RowBox[{"\[Lambda]", ",", "l", ",", "kres", ",", "kres"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"PsiUTilde", "[", 
             RowBox[{"\[Lambda]", ",", "l", ",", "kres", ",", "z"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "2"}], "}"}]}], "]"}], "/.", 
          RowBox[{"z", "->", "kres"}]}], ")"}], "/", 
        RowBox[{"PsiUTilde", "[", 
         RowBox[{"\[Lambda]", ",", "l", ",", "kres", ",", "kres"}], "]"}]}], 
       ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XSExpansion1", "[", 
      RowBox[{"g_", ",", "L_", ",", "k_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"BW", "[", 
       RowBox[{"g", ",", "L", ",", "k"}], "]"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "-", "kres"}], ")"}], "*", "c1"}]}], "]"}], "^", 
       "4"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XSExpansion2", "[", 
      RowBox[{"g_", ",", "L_", ",", "k_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"BW", "[", 
       RowBox[{"g", ",", "L", ",", "k"}], "]"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "-", "kres"}], ")"}], "*", "c1"}], "+", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", "-", "kres"}], ")"}], "^", "2"}], "*", "c2"}]}], 
        "]"}], "^", "4"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Plot", " ", "Exact"}], ",", " ", "BW", ",", " ", 
     RowBox[{"and", " ", "Modified", " ", 
      RowBox[{"XS", "'"}], "s", " ", "to", " ", "Compare"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
