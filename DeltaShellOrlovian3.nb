Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NN", "=", 
     RowBox[{
      RowBox[{"PsiUTilde", "[", 
       RowBox[{"\[Lambda]", ",", "l", ",", "kres", ",", "kres"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[Mu]", "*", 
         RowBox[{"Im", "[", "Eres", "]"}]}], "]"}], ")"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Normalize", " ", "PsiUTilde", " ", "at", " ", "the", " ", "peak", " ", 
     "artificially"}], "*)"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"k", "[", 
      RowBox[{"g_", ",", "L_", ",", "n_"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"n", "!"}], ")"}]}], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"PsiUTilde", "[", 
          RowBox[{"g", ",", "L", ",", "kres", ",", "z"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "n"}], "}"}]}], "]"}]}], "/.", " ", 
      RowBox[{"z", "->", "kres"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PsiUTildePoly", "[", 
      RowBox[{"g_", ",", "L_", ",", "p_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", 
         RowBox[{"g", ",", "L", ",", "i"}], "]"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", "-", "kres"}], ")"}], "^", "i"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TMatrixPoly", "[", 
      RowBox[{"g_", ",", "L_", ",", "p_", ",", "n_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "\[Mu]"}], ")"}], "^", "2"}]}], ")"}], 
      RowBox[{
       RowBox[{
        RowBox[{"PsiUTildePoly", "[", 
         RowBox[{"\[Lambda]", ",", "l", ",", "p", ",", "n"}], "]"}], "^", 
        "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"NNsq", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"kres", "^", "2"}], "-", 
           RowBox[{"p", "^", "2"}]}], ")"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Use", " ", "unitary", " ", "limit", " ", "prefactor", " ", "since", " ", 
     "T", " ", "is", " ", "normalized", " ", "to", " ", "1", " ", "at", " ", 
     "the", " ", "pole"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XSPoly", "[", 
      RowBox[{"g_", ",", "L_", ",", "p_", ",", "n_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"64", " ", 
        RowBox[{"Pi", "^", "5"}], " ", 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "L"}], "+", "1"}], ")"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", 
          RowBox[{"Pi", "/", 
           RowBox[{"p", "^", "2"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "L"}], "+", "1"}], ")"}]}], "*)"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"TMatrixPoly", "[", 
         RowBox[{"g", ",", "L", ",", "p", ",", "n"}], "]"}], "]"}], "^", 
       "2"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"XS", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z"}], "]"}], ",", 
       RowBox[{"XSPoly", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "1"}], "]"}], ",", 
       RowBox[{"XSPoly", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "2"}], "]"}], ",", 
       RowBox[{"XSPoly", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "3"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "4.2", ",", "5.2"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Exact\>\"", ",", "\"\<1\>\"", ",", "\"\<2\>\"", 
        ",", "\"\<3\>\""}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"AbsArgPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TMatrixPoly", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "2"}], "]"}], ",", 
       RowBox[{"TFactorized", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "z", ",", "z"}], 
        "]"}]}], 
      RowBox[{"(*", 
       RowBox[{"*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"T", "[", 
           RowBox[{
           "\[Lambda]", ",", "l", ",", "kresreal", ",", "kresreal", ",", 
            "kresreal"}], "]"}], "/", 
          RowBox[{"TFactorized", "[", 
           RowBox[{
           "\[Lambda]", ",", "l", ",", "kresreal", ",", "kresreal", ",", 
            "kresreal"}], "]"}]}], ")"}]}], "*)"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"kresreal", "-", "buffer"}], ",", 
       RowBox[{"kresreal", "+", "buffer"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}]}], " ", "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Solid=Exact T, Dashed=Factorized T\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<k\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "300"}]}], "]"}]}]}]], "Input",
