   "Lets", " ", "try", " ", "adding", " ", "in", " ", "the", " ", "next", " ",
     "resonance"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"kres2", "=", 
