Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"K", " ", "MATRIX", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"APPROACH", "!!"}], "!!"}], "!!"}], "!!"}], "!!"}], 
         "!!"}], "!!"}], "!!"}], "!!"}], " ", "Find", " ", "the", " ", 
     "inverse", " ", "K", " ", "matrix", " ", "to", " ", "avoid", " ", 
     "expanding", " ", "around", " ", "a", " ", "pole"}], ",", " ", 
    RowBox[{"then", " ", "reinvert", " ", "to", " ", "get", " ", "K"}]}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"KMatrixInversePoly", "[", 
      RowBox[{"g_", ",", "L_", ",", "p_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Re", "[", 
      RowBox[{"1", "/", 
       RowBox[{"TMatrixPoly", "[", 
        RowBox[{"g", ",", "L", ",", "p", ",", "n"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KMatrixInverseFactorized", "[", 
      RowBox[{"g_", ",", "L_", ",", "p_"}], "]"}], "=", 
     RowBox[{"Re", "[", 
      RowBox[{"1", "/", 
       RowBox[{"TFactorized", "[", 
        RowBox[{"g", ",", "L", ",", "p", ",", "p", ",", "p"}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"XSKMatrixInversePoly", "[", 
     RowBox[{"g_", ",", "L_", ",", "p_", ",", "n_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"64", " ", 
       RowBox[{"Pi", "^", "5"}], " ", 
       RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "L"}], "+", "1"}], ")"}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", 
         RowBox[{"Pi", "/", 
          RowBox[{"p", "^", "2"}]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "L"}], "+", "1"}], ")"}]}], "*)"}], "*", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"KMatrixInversePoly", "[", 
          RowBox[{"g", ",", "L", ",", "p", ",", "n"}], "]"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", "*", 
           RowBox[{"Pi", "^", "2"}], "*", "\[Mu]", "*", "p"}], ")"}], "^", 
         "2"}]}], ")"}]}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Because", " ", "of", " ", "the", " ", "0", " ", "at", " ", "4.4"}], ",",
      " ", 
     RowBox[{
     "ROC", " ", "is", " ", "confined", " ", "to", " ", "at", " ", "most", " ",
       "0.3"}], ",", " ", 
     RowBox[{
     "which", " ", "is", " ", "probably", " ", "why", " ", "the", " ", 
      "tails", " ", "arent", " ", "great", " ", "here"}], ",", " ", 
     RowBox[{
     "but", " ", "it", " ", "nails", " ", "the", " ", "peak", " ", "at", " ", 
      RowBox[{"least", "!"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"BW", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z"}], "]"}], ",", 
       RowBox[{"XS", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z"}], "]"}], ",", 
       RowBox[{"XSKMatrixInversePoly", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "1"}], "]"}], ",", 
       RowBox[{"XSKMatrixInversePoly", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "2"}], "]"}], ",", 
       RowBox[{"XSKMatrixInversePoly", "[", 
        RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "3"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "4.2", ",", "5.2"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Thickness", "[", "0.01", "]"}], "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}], ",", 
        RowBox[{"{", "Dashed", "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<BW\>\"", ",", "\"\<Exact\>\"", ",", "\"\<1\>\"", 
        ",", "\"\<2\>\"", ",", "\"\<3\>\""}], "}"}]}]}], "]"}]}]}]], "Input",
