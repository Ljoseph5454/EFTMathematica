Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Hmmm", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "seems", " ", "that", " ", "constructing", " ", "KMatrixFactorized", " ",
        "directly", " ", "from", " ", "TFactorized", " ", "is", " ", "bad"}], 
      "..."}], " ", "must", " ", "first", " ", "find", " ", "Inverse", " ", 
     "K", " ", "matrix", " ", "by", " ", "taking", " ", "real", " ", 
     "component", " ", "of", " ", "TFactorized", " ", "and", " ", "then", " ",
      "inverting", " ", "to", " ", "find", " ", "K"}], ",", " ", 
    RowBox[{
    "I", " ", "guess", " ", "that", " ", "avoids", " ", "weird", " ", "pole", 
     " ", "issues", 
     RowBox[{"??", 
      RowBox[{"??", " ", 
       RowBox[{"Weird", "..."}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"KMatrixInversePoly", "[", 
       RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "2"}], "]"}], ",", 
      RowBox[{"Re", "[", 
       RowBox[{"1", "/", 
        RowBox[{"TFactorized", "[", 
         RowBox[{"\[Lambda]", ",", "l", ",", "z", ",", "z", ",", "z"}], 
         "]"}]}], "]"}]}], 
     RowBox[{"(*", 
      RowBox[{"*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"T", "[", 
          RowBox[{
          "\[Lambda]", ",", "l", ",", "kresreal", ",", "kresreal", ",", 
           "kresreal"}], "]"}], "/", 
         RowBox[{"TFactorized", "[", 
          RowBox[{
          "\[Lambda]", ",", "l", ",", "kresreal", ",", "kresreal", ",", 
           "kresreal"}], "]"}]}], ")"}]}], "*)"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", 
      RowBox[{"kresreal", "-", "buffer"}], ",", 
      RowBox[{"kresreal", "+", "buffer"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{"{", "Dashed", "}"}]}], " ", "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<Solid=Exact T, Dashed=Factorized T\>\""}],
     ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<k\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "300"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.979702159635103*^9, 3.979702180558069*^9}, {
