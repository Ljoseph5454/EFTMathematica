       RowBox[{"kresreal", "-", "buffer"}], ",", 
       RowBox[{"kresreal", "+", 
        RowBox[{"2", "*", "buffer"}]}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Blue", ",", 
          RowBox[{"Thickness", "[", "0.01", "]"}]}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Exact", ":", 
          RowBox[{"Thick", " ", "Blue"}]}], "*)"}], 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Dashed"}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Standard", " ", 
          RowBox[{"BW", ":", 
           RowBox[{"Dashed", " ", "Red"}]}]}], "*)"}], 
        RowBox[{"{", 
         RowBox[{"Green", ",", 
          RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], "     ", 
       RowBox[{"(*", 
        RowBox[{"Perturbative", " ", "1", "st", " ", 
         RowBox[{"order", ":", 
          RowBox[{"Thin", " ", "Green"}]}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{",", 
         RowBox[{"{", 
          RowBox[{"Orange", ",", 
           RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], "     ", 
        RowBox[{"(*", 
         RowBox[{"Perturbative", " ", "2", "nd", " ", 
          RowBox[{"order", ":", 
           RowBox[{"Thin", " ", "Orange"}]}]}], "*)"}], "*)"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Exact T-Matrix\>\"", ",", "\"\<Standard BW\>\"", 
        ",", "\"\<Orlovian-Shifted BW (1st order)\>\""}], 
       RowBox[{"(*", 
        RowBox[{",", "\"\<Orlovian-Shifted BW (2nd order)\>\""}], "*)"}], 
       "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
