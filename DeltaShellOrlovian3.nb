              RowBox[{"l", ",", 
               RowBox[{"z", "*", "a"}]}], "]"}], "*", 
             RowBox[{"SphericalHankelH1", "[", 
              RowBox[{"l", ",", 
               RowBox[{"z", "*", "a"}]}], "]"}]}]}], ")"}], ",", "z"}], "]"}],
         "/.", 
        RowBox[{"z", "->", "kres2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
