Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Re", " ", "invert", " ", "the", " ", "inverse", " ", "K", " ", "matrix", " ",
     "to", " ", "get", " ", "K"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"KMatrixPoly", "[", 
     RowBox[{"g_", ",", "L_", ",", "p_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{"KMatrixInversePoly", "[", 
      RowBox[{"g", ",", "L", ",", "p", ",", "n"}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KMatrixFactorized", "[", 
      RowBox[{"g_", ",", "L_", ",", "p_"}], "]"}], "=", 
     RowBox[{"1", "/", 
      RowBox[{"KMatrixInverseFactorized", "[", 
       RowBox[{"g", ",", "L", ",", "p"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"XSKMatrixPoly", "[", 
     RowBox[{"g_", ",", "L_", ",", "p_", ",", "n_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"64", " ", 
       RowBox[{"Pi", "^", "5"}], " ", 
       RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "L"}], "+", "1"}], ")"}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", 
         RowBox[{"Pi", "/", 
          RowBox[{"p", "^", "2"}]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "L"}], "+", "1"}], ")"}]}], "*)"}], "*", 
     RowBox[{
      RowBox[{
       RowBox[{"KMatrixPoly", "[", 
        RowBox[{"g", ",", "L", ",", "p", ",", "n"}], "]"}], "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", "*", 
           RowBox[{"Pi", "^", "2"}], "*", "\[Mu]", "*", "p", "*", 
           RowBox[{"KMatrixPoly", "[", 
            RowBox[{"g", ",", "L", ",", "p", ",", "n"}], "]"}]}], ")"}], "^", 
         "2"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"XSKMatrixFactorized", "[", 
      RowBox[{"g_", ",", "L_", ",", "p_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"64", " ", 
        RowBox[{"Pi", "^", "5"}], " ", 
        RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "L"}], "+", "1"}], ")"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", 
          RowBox[{"Pi", "/", 
           RowBox[{"p", "^", "2"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "L"}], "+", "1"}], ")"}]}], "*)"}], "*", 
      RowBox[{
       RowBox[{
        RowBox[{"KMatrixFactorized", "[", 
         RowBox[{"g", ",", "L", ",", "p"}], "]"}], "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"4", "*", 
            RowBox[{"Pi", "^", "2"}], "*", "\[Mu]", "*", "p", "*", 
            RowBox[{"KMatrixFactorized", "[", 
             RowBox[{"g", ",", "L", ",", "p"}], "]"}]}], ")"}], "^", "2"}]}], 
        ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
