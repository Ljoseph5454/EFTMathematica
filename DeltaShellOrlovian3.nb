         RowBox[{"u", "^", "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ExactTResidue2", " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Lambda]", "*", 
              RowBox[{"a", "^", "2"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"4", "*", 
              RowBox[{"Pi", "^", "2"}], "*", "\[Mu]"}], ")"}]}], ")"}]}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SphericalBesselJ", "[", 
            RowBox[{"l", ",", 
             RowBox[{"z", "*", "a"}]}], "]"}], "*", 
           RowBox[{"SphericalBesselJ", "[", 
            RowBox[{"l", ",", 
             RowBox[{"z", "*", "a"}]}], "]"}]}], ")"}]}], "/.", 
        RowBox[{"z", "->", "kres2"}]}], ")"}], "/", 
      RowBox[{"(", 
